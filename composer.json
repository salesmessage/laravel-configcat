{
    "name": "salesmessage/laravel-configcat",
    "description": "Implement feature flags with ConfigCat cloud service",
    "keywords": [
        "salesmessage",
        "laravel",
        "configcat",
        "feature",
        "flags"
    ],
    "homepage": "https://github.com/salesmessage/laravel-configcat",
    "license": "MIT",
    "authors": [
        {
            "name": "Salesmessage Software Team",
            "email": "dev@salesmessage.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "configcat/configcat-client": "^9.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.28|^3.0",
        "mockery/mockery": "^1.6.7"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "PodPoint\\ConfigCat\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PodPoint\\ConfigCat\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PodPoint\\ConfigCat\\ConfigCatServiceProvider"
            ],
            "aliases": {
                "ConfigCat": "PodPoint\\ConfigCat\\Facades\\ConfigCat"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "pestphp/pest-plugin": true
        }
    }
}
